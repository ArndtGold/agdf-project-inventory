{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agdf.iself.eu/project-inventory/schemas/assessment-intake-v1.json",
  "title": "Project Inventory Assessment Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "decision", "audience", "scope", "exclusions", "source_boundary", "time_boundary", "review_owner", "permitted_unknowns", "confidentiality"],
  "properties": {
    "schema_version": { "const": "1" },
    "intake_id": { "$ref": "#/$defs/id" },
    "decision": { "$ref": "#/$defs/text" },
    "audience": { "$ref": "#/$defs/text_list" },
    "scope": { "$ref": "#/$defs/text_list" },
    "exclusions": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "source_boundary": { "$ref": "#/$defs/text_list" },
    "time_boundary": { "$ref": "#/$defs/text" },
    "review_owner": { "$ref": "#/$defs/text" },
    "permitted_unknowns": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "confidentiality": { "enum": ["public", "internal", "confidential", "restricted"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "text": { "type": "string", "minLength": 1 },
    "text_list": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }
  }
}
