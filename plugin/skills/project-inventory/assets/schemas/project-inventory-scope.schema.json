{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agdf.iself.eu/project-inventory/schemas/project-inventory-scope-v1.json",
  "title": "Project Inventory Scope Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "agdf_run_id", "approval_ref", "approval_gate", "approval_revision_id", "decision_context", "allowed_outputs", "source_boundary", "confidentiality"],
  "properties": {
    "schema_version": { "const": "1" },
    "scope_id": { "$ref": "#/$defs/id" },
    "agdf_run_id": { "$ref": "#/$defs/id" },
    "approval_ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))\\.agdf/control/artefacts/[A-Za-z0-9._/-]+\\.md#[A-Za-z0-9._:-]+$" },
    "approval_gate": { "enum": ["UR", "PRD"] },
    "approval_revision_id": { "$ref": "#/$defs/revision_id" },
    "decision_context": { "type": "string", "minLength": 1 },
    "allowed_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["assessment_intake", "evidence_register", "findings_register", "inventory_report", "management_view"] }
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_roots", "external_systems", "exclusions"],
      "properties": {
        "repository_roots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "external_systems": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "confidentiality": { "$ref": "#/$defs/confidentiality" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
    "confidentiality": { "enum": ["public", "internal", "confidential", "restricted"] },
    "revision_id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" }
  }
}
